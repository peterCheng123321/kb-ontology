demo:LinkMethodEnum\#dtc_code a owl:Class ;
	rdfs:label "dtc_code" ;
	rdfs:subClassOf demo:LinkMethodEnum ;
	skos:definition "Repair step or part joins a DTC by official/sample code (hard key)" .
demo:LinkMethodEnum\#dtc_regex_cooccur a owl:Class ;
	rdfs:label "dtc_regex_cooccur" ;
	rdfs:subClassOf demo:LinkMethodEnum ;
	skos:definition "DTC regex extracted from a complaint narrative (narrative itself is not stored) and co-occurs with a component row" .
demo:LinkMethodEnum\#inv_campno a owl:Class ;
	rdfs:label "inv_campno" ;
	rdfs:subClassOf demo:LinkMethodEnum ;
	skos:definition "Official investigation CAMPNO equals recall CAMPNO (hard key)" .
demo:LinkMethodEnum\#mmy_comp_exact a owl:Class ;
	rdfs:label "mmy_comp_exact" ;
	rdfs:subClassOf demo:LinkMethodEnum ;
	skos:definition "Same make, model, year and exact component description" .
demo:LinkMethodEnum\#mmy_comp_head a owl:Class ;
	rdfs:label "mmy_comp_head" ;
	rdfs:subClassOf demo:LinkMethodEnum ;
	skos:definition "Same make, model, year and canonical component head" .
demo:LinkMethodEnum\#qa_zh_lexicon a owl:Class ;
	rdfs:label "qa_zh_lexicon" ;
	rdfs:subClassOf demo:LinkMethodEnum ;
	skos:definition "Chinese QA text hits a bilingual component lexicon; no model year" .
demo:LinkMethodEnum a owl:Class ;
	rdfs:label "LinkMethodEnum" ;
