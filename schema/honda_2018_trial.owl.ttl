<https://w3id.org/poc-kb/demo.owl.ttl> dcterms:title "Honda CR-V and Accord 2018 exploratory trial schema" ;
	a owl:Ontology ;
	rdfs:label "honda_2018_trial" ;
	skos:definition "Minimal schema for a public-data exploratory trial. Capabilities are not pre-declared. No VIN or complaint narrative properties." .
demo:CandidateLink a owl:Class ;
	rdfs:label "CandidateLink" ;
	rdfs:subClassOf demo:NamedThing , _:c14n100 , _:c14n107 , _:c14n109 , _:c14n110 , _:c14n123 , _:c14n125 , _:c14n131 , _:c14n14 , _:c14n152 , _:c14n26 , _:c14n29 , _:c14n38 , _:c14n48 , _:c14n50 , _:c14n68 , _:c14n7 , _:c14n71 , _:c14n84 , _:c14n86 , _:c14n92 , _:c14n98 ;
	skos:definition "A derived or official-candidate relation that must carry method, score and review status." ;
	skos:inScheme <https://w3id.org/poc-kb/demo> .
