@prefix core: <https://w3id.org/poc-kb/core/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/poc-kb/core/vehicle/BAD_VEH> a core:VehicleModelYear, core:NamedThing ;
    core:make "HONDA" ;
    core:model "CR-V" ;
    core:modelYear "2018" .

# 反例：字面量是占位符，测试在解析前换成合成标记，文件内不出现 17 位识别号。
<https://w3id.org/poc-kb/core/complaint/BAD_VIN> a core:Complaint, core:NamedThing ;
    core:odino "99999999" ;
    core:vehicle <https://w3id.org/poc-kb/core/vehicle/BAD_VEH> ;
    rdfs:label "VIN_PLACEHOLDER" .
