@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix vsso: <https://github.com/w3c/vsso#> .
@prefix core: <https://w3id.org/poc-kb/core/> .
@prefix signal: <https://w3id.org/poc-kb/signal/> .
@prefix evb: <https://w3id.org/poc-kb/evb/> .

# OWL 2 DL declaration supplement merged by ci/robot.sh:
# LinkML gen-owl uses these annotation properties without declaring them as owl:AnnotationProperty.
<https://w3id.org/poc-kb/catalog.owl.ttl> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/poc-kb/catalog/3.0.0-exp> ;
    owl:versionInfo "3.0.0-exp" ;
    dc:description "Data-first modular LinkML ontology for multi-source automotive after-sales knowledge base experiments (POC v3.0-exp)." ;
    dcterms:description "Data-first modular LinkML ontology for multi-source automotive after-sales knowledge base experiments (POC v3.0-exp)." .

<https://w3id.org/poc-kb/catalog> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/poc-kb/catalog/3.0.0-exp> ;
    owl:versionInfo "3.0.0-exp" ;
    dc:description "Data-first modular LinkML ontology for multi-source automotive after-sales knowledge base experiments (POC v3.0-exp)." ;
    dcterms:description "Data-first modular LinkML ontology for multi-source automotive after-sales knowledge base experiments (POC v3.0-exp)." .

dc:description a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .
skos:inScheme a owl:AnnotationProperty .
skos:exactMatch a owl:AnnotationProperty .
skos:closeMatch a owl:AnnotationProperty .
skos:broader a owl:AnnotationProperty .
skos:note a owl:AnnotationProperty .
skos:editorialNote a owl:AnnotationProperty .
linkml:permissible_values a owl:AnnotationProperty .
linkml:examples a owl:AnnotationProperty .
linkml:annotations a owl:AnnotationProperty .
<https://w3id.org/poc-kb/core/owl_version_iri> a owl:AnnotationProperty .
<https://w3id.org/poc-kb/core/upper_ontology_policy> a owl:AnnotationProperty .
<https://w3id.org/poc-kb/core/privacy_policy> a owl:AnnotationProperty .
<https://w3id.org/poc-kb/core/bfo_alignment> a owl:AnnotationProperty .

# External standard alignment stubs (no full BFO/SOSA/VSSo axiom import at runtime per TECH-STACK §2.11)
sosa:Observation a owl:Class .
vsso:ObservableSignal a owl:Class .
evb:BatterySnippetSummary skos:closeMatch sosa:Observation .
signal:VehicleSignal skos:closeMatch vsso:ObservableSignal .
