@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix core: <https://w3id.org/poc-kb/core/> .

# 每个有 rdf:type 的节点都检查。没有类型的节点不是类实例，不在目标内。
# REGEX 使用 XPath 语法：不用 \b，用首尾或非字母数字作为边界，并用 i 忽略大小写。
core:PrivacyGuardShape a sh:NodeShape ;
    sh:targetSubjectsOf rdf:type ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Privacy violation: literal matches 17-character VIN pattern." ;
        sh:select """
            SELECT $this ?p ?v
            WHERE {
                $this ?p ?v .
                FILTER(isLiteral(?v) && REGEX(STR(?v), "(^|[^A-Za-z0-9])[A-HJ-NPR-Z0-9]{17}([^A-Za-z0-9]|$)", "i"))
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Privacy violation: forbidden PII/narrative/vehicle_id predicate detected." ;
        sh:select """
            SELECT $this ?p
            WHERE {
                $this ?p ?v .
                FILTER(REGEX(LCASE(STR(?p)), "(^|/|#)(vin|vehicle_id|vehicleid|cdescr|narrative|rawdialogue|dialogue)$"))
            }
        """ ;
    ] .
